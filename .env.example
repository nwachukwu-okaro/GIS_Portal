# Django
DJANGO_SECRET_KEY=replace-with-a-production-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostGIS
GIS_DB_HOST=gisdb.example.internal
GIS_DB_PORT=5432
GIS_DB_NAME=gis_database
GIS_DB_USER=YOUR_DB_USER
GIS_DB_PASSWORD=YOUR_DB_PASSWORD
GIS_DB_SSLMODE=require

# Catalogue and object storage (used by the portal, not the metadata builder)
PYCSW_STAC_URL=mock
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=YOUR_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=YOUR_MINIO_SECRET_KEY

# Email (SMTP) — used by metadata_builder/monitor_new_tables.py to send
# compliance alerts
EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_HOST_USER=YOUR_SMTP_USER@systra.com
EMAIL_HOST_PASSWORD=YOUR_SMTP_PASSWORD
EMAIL_USE_TLS=True
EMAIL_FROM=gis_uk@systra.com
